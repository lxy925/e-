{
  "name": "checkExpiredOrders",
  "version": "1.0.0",
  "description": "检查过期订单",
  "main": "index.js",
  "dependencies": {},
  "cloudfunction-config": {
    "memorySize": 256,
    "timeout": 5,
    "triggers": [
      {
        "name": "checkExpiredOrdersTrigger",
        "type": "timer",
        "config": "0 */1 * * * * *" // 每分钟执行一次
      }
    ]
  }
}