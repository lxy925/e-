{"bsonType":"object","required":["user_id","name","avatarUrl","gender","age","address","state","create_time","update_time"],"permission":{"read":true,"create":true,"update":true,"delete":true},"properties":{"_id":{"description":"ID，系统自动生成"},"user_id":{"bsonType":"string","description":"用户ID，JWT格式的用户唯一标识","maxLength":255},"qualification_id":{"bsonType":"string","description":"资格证号ID","maxLength":50,"optional":true},"name":{"bsonType":"string","description":"姓名","maxLength":50},"avatarUrl":{"bsonType":"string","description":"头像地址","maxLength":500},"gender":{"bsonType":"string","description":"性别","enum":["男","女"]},"age":{"bsonType":"string","description":"年龄","maxLength":10},"address":{"bsonType":"object","description":"地址","required":["provinceName","cityName","areaName"],"properties":{"provinceName":{"bsonType":"string","description":"省份名称","maxLength":50},"cityName":{"bsonType":"string","description":"城市名称","maxLength":50},"areaName":{"bsonType":"string","description":"区域名称","maxLength":50}}},"is_certified":{"bsonType":"bool","description":"是否认证","defaultValue":false},"certificate":{"bsonType":"string","description":"证书（图片类型）","maxLength":500},"parentId":{"bsonType":"string","description":"上级陪诊师的user_id","defaultValue":"undefined"},"state":{"bsonType":"string","description":"审核状态","enum":["待审核","不通过","通过"],"defaultValue":"待审核"},"create_time":{"bsonType":"number","description":"创建时间(时间戳)"},"update_time":{"bsonType":"number","description":"更新时间(时间戳)"}}}