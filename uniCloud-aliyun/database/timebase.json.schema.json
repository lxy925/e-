{
  "bsonType": "object",
  "required": [
    "user_id",
    "day_of_week",
    "time_period",
    "status"
  ],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": true
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成",
      "bsonType": "string"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户ID"
    },
    "day_of_week": {
      "bsonType": "int",
      "minimum": 1,
      "maximum": 7,
      "description": "1-7表示周一到周日"
    },
    "time_period": {
      "bsonType": "int",
      "minimum": 1,
      "maximum": 2,
      "description": "1:上午, 2:下午"
    },
    "status": {
      "bsonType": "int",
      "minimum": 0,
      "maximum": 1,
      "description": "1:长期出诊, 0:长期不出诊"
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "updated_at": {
      "bsonType": "timestamp",
      "description": "更新时间"
    },
    "indexes": [
      {
        "name": "user_schedule_unique",
        "key": {
          "user_id": 1,
          "day_of_week": 1,
          "time_period": 1
        },
        "unique": true,
        "description": "确保用户每天每个时间段只有一条记录"
      },
      {
        "name": "user_id_index",
        "key": {
          "user_id": 1
        },
        "description": "加速按用户ID查询"
      }
    ]
  }
}