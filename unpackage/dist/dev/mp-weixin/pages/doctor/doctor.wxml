<view class="page"><custom-nav class="vue-ref" vue-id="b2441e40-1" title="{{pageTitle}}" isHomePage="{{true}}" scrollTop="{{scrollTop}}" data-ref="customNav" bind:__l="__l"></custom-nav><scroll-view class="page-container" style="{{'padding-top:'+(navHeight+'px')+';'}}"><view class="content" style="padding:0rpx;"><view class="first"><swiper class="swiper" circular="{{true}}" autoplay="{{true}}" interval="3000" duration="500"><block wx:for="{{banners}}" wx:for-item="banner" wx:for-index="index" wx:key="index"><swiper-item><image class="swiper-image" src="{{banner.image}}" mode="aspectFill"></image><text class="swiper-text">{{banner.title}}</text></swiper-item></block></swiper></view><view class="second"><view data-event-opts="{{[['tap',[['handleSignUp',['$event']]]]]}}" class="second-item1" bindtap="__e"><view class="second-item1-text"><text class="second-item1-text1">报名</text><text class="second-item1-text2">精选推荐</text><text class="second-item1-text3">了解更多</text></view><image src="../../static/images/index/listen.png" alt></image></view><view data-event-opts="{{[['tap',[['goToStudyPage',['$event']]]]]}}" class="second-item2" bindtap="__e"><view class="second-item2-text"><text class="second-item2-text1">学习</text><text class="second-item2-text2">一起来分享</text><text class="second-item2-text3">了解更多</text></view><image src="../static/images/index/money.png" alt></image></view></view><view class="third"><text class="third-title">优秀陪诊师</text><text data-event-opts="{{[['tap',[['goToDoctorListPage',['$event']]]]]}}" class="third-text" bindtap="__e">更多 ></text></view><view class="doctor-list"><block wx:for="{{doctors}}" wx:for-item="doctor" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goToDoctorDetailPage',['$0'],[[['doctors','',index]]]]]]]}}" class="doctor-card" bindtap="__e"><view class="doctor-avatar"><image src="{{doctor.avatarUrl}}" mode="aspectFill"></image></view><view class="doctor-info"><view class="doctor-first"><view class="doctor-name">{{doctor.name}}</view><view class="doctor-gender">{{doctor.gender}}</view></view><view class="doctor-location">{{doctor.address.cityName+" "+doctor.address.areaName+''}}</view><view class="doctor-department"><image class="value-icon _img" src="{{$root.m0}}" alt></image>{{''+doctor.moreInfo.rating+'   |'}}<image class="order-icon _img" src="{{$root.m1}}" alt></image>{{''+doctor.moreInfo.order+''}}</view><view class="doctor-tags"><text class="{{['doctor-certification',doctor.is_certified?'certified':'uncertified']}}">{{''+(doctor.is_certified?'已认证':'未认证')+''}}</text><text class="{{['doctor-availability',doctor.is_bookable?'available':'unavailable']}}">{{''+(doctor.is_bookable?'可预约':'不可预约')+''}}</text></view></view><view class="doctor-need"><view class="doctor-need-item"><view class="doctor-need-item-text">最近咨询</view><image src="../../static/images/index/star.png" alt></image></view></view></view></block></view></view></scroll-view></view>