<view class="page"><custom-nav class="vue-ref" vue-id="b2441e40-1" title="{{pageTitle}}" isHomePage="{{true}}" scrollTop="{{scrollTop}}" data-ref="customNav" bind:__l="__l"></custom-nav><scroll-view class="page-container" style="{{'padding-top:'+(navHeight+'px')+';'}}"><view class="content" style="padding:0rpx;"><view class="first"><swiper class="swiper" circular="{{true}}" autoplay="{{true}}" interval="3000" duration="500"><block wx:for="{{banners}}" wx:for-item="banner" wx:for-index="index" wx:key="index"><swiper-item><image class="swiper-image" src="{{banner.image}}" mode="aspectFill"></image><text class="swiper-text">{{banner.title}}</text></swiper-item></block></swiper></view><view class="second"><view data-event-opts="{{[['tap',[['handleSignUp',['$event']]]]]}}" class="action-card action-card-signup" bindtap="__e"><view class="action-content"><view class="action-icon"><uni-icons vue-id="b2441e40-2" type="plus" size="28" color="#fff" bind:__l="__l"></uni-icons></view><view class="action-text"><text class="action-title">立即报名</text><text class="action-desc">成为专业陪诊师</text></view></view></view><view data-event-opts="{{[['tap',[['goToStudyPage',['$event']]]]]}}" class="action-card action-card-study" bindtap="__e"><view class="action-content"><view class="action-icon"><uni-icons vue-id="b2441e40-3" type="star" size="28" color="#fff" bind:__l="__l"></uni-icons></view><view class="action-text"><text class="action-title">专业培训</text><text class="action-desc">提升陪诊技能</text></view></view></view></view><view class="third"><text class="third-title">优秀陪诊师</text><text data-event-opts="{{[['tap',[['goToDoctorListPage',['$event']]]]]}}" class="third-text" bindtap="__e">更多 ></text></view><view class="doctor-list"><block wx:for="{{doctors}}" wx:for-item="doctor" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goToDoctorDetailPage',['$0'],[[['doctors','',index]]]]]]]}}" class="doctor-card" bindtap="__e"><view class="doctor-avatar"><image src="{{doctor.avatarUrl}}" mode="aspectFill"></image></view><view class="doctor-info"><view class="doctor-first"><view class="doctor-name">{{doctor.name}}</view><view class="doctor-gender">{{doctor.gender}}</view></view><view class="doctor-location">{{doctor.address.cityName+" "+doctor.address.areaName+''}}</view><view class="doctor-department"><uni-icons vue-id="{{'b2441e40-4-'+index}}" type="star-filled" size="30" bind:__l="__l"></uni-icons>{{''+doctor.moreInfo.rating+'   |'}}<uni-icons vue-id="{{'b2441e40-5-'+index}}" type="wallet-filled" size="30" bind:__l="__l"></uni-icons>{{''+doctor.moreInfo.order+''}}</view><view class="doctor-tags"><text class="{{['doctor-certification',doctor.is_certified?'certified':'uncertified']}}">{{''+(doctor.is_certified?'已认证':'未认证')+''}}</text></view></view><view class="doctor-need"><view class="doctor-need-item"><view class="doctor-need-item-text">最近咨询</view><image src="../../static/images/index/star.png" alt></image></view></view></view></block></view></view></scroll-view></view>