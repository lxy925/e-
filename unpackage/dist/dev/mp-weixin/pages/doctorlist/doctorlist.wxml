<view class="page"><custom-nav class="vue-ref" vue-id="a45582c0-1" title="{{pageTitle}}" isHomePage="{{false}}" scrollTop="{{scrollTop}}" data-ref="customNav" bind:__l="__l"></custom-nav><scroll-view class="page-container" style="{{'padding-top:'+(navHeight+'px')+';'+('height:'+('calc(100vh - '+navHeight+'px)')+';')}}" scroll-y="{{true}}" scroll-top="{{scrollTop}}" show-scrollbar="{{false}}" data-event-opts="{{[['scroll',[['handleScroll',['$event']]]]]}}" bindscroll="__e"><view class="search-box"><image class="search-icon" src="../../static/images/icons/search.png"></image><input type="text" placeholder="搜索陪诊师的名字" placeholder-class="placeholder-style" data-event-opts="{{[['input',[['__set_model',['','searchKeyword','$event',[]]],['handleSearch',['$event']]]]]}}" value="{{searchKeyword}}" bindinput="__e"/></view><view class="doctor-list"><block wx:for="{{doctors}}" wx:for-item="doctor" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goToDoctorDetailPage',['$0'],[[['doctors','',index]]]]]]]}}" class="doctor-card" bindtap="__e"><view class="doctor-avatar"><image src="{{doctor.avatarUrl}}" mode="aspectFill"></image></view><view class="doctor-info"><view class="doctor-first"><view class="doctor-name">{{doctor.name}}</view><view class="doctor-gender">{{doctor.gender}}</view></view><view class="doctor-location">{{doctor.address.cityName+" "+doctor.address.areaName+''}}</view><view class="doctor-department"><image class="value-icon _img" src="{{$root.m0}}" alt></image>{{''+doctor.moreInfo.rating+'   |'}}<image class="order-icon _img" src="{{$root.m1}}" alt></image>{{''+doctor.moreInfo.order+''}}</view><view class="doctor-tags"><text class="{{['doctor-certification',doctor.is_certified?'certified':'uncertified']}}">{{''+(doctor.is_certified?'已认证':'未认证')+''}}</text><text class="{{['doctor-availability',doctor.is_bookable?'available':'unavailable']}}">{{''+(doctor.is_bookable?'可预约':'不可预约')+''}}</text></view></view><view class="doctor-need"><view class="doctor-need-item"><view class="doctor-need-item-text">最近咨询</view><image src="../../static/images/index/star.png" alt></image></view></view></view></block></view></scroll-view></view>