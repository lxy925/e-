
.page {
	height: 100vh;
	/* background-color: #2ecc71; */
}
.page-container {
	min-height: 100vh;
	position: relative;
	
	
	margin: 0;
	width: 100%;
	box-sizing: border-box;
	/* 关键：让 width 包含 padding */
	-webkit-overflow-scrolling: touch;
	/* 平滑滚动 */
	scrollbar-width: none;
	/* Firefox */
}
.page-container ::-webkit-scrollbar {
	display: none;
	/* Chrome/Safari */
	width: 0 !important;
	/* 微信小程序可能需要 */
	height: 0 !important;
}
.first {
	display: flex;
	flex-direction: column;
	justify-content: center;
	/* 水平居中 */
	align-items: center;
	/* 垂直居中 */
}
.announcement-bar {
	width: 100%;
	overflow: hidden;
	background-color: #f5f5f5;
	padding: 0;
	display: flex;
	align-items: center;
	position: relative;
}
.notice {
	position: absolute;
	left: 20rpx;
	width: 60rpx;
	height: 60rpx;
	z-index: 1;
	/* 确保图片在文字上方 */
}
.scroll-container {
	display: flex;
	overflow: hidden;
	margin-left: 80rpx;
	/* 为滚动区域留出图片的宽度 */
}
.announcement-text {
	white-space: nowrap;
	-webkit-animation: scroll-left 15s linear infinite;
	        animation: scroll-left 15s linear infinite;
}
@-webkit-keyframes scroll-left {
0% {
		-webkit-transform: translateX(100%);
		        transform: translateX(100%);
}
100% {
		-webkit-transform: translateX(-100%);
		        transform: translateX(-100%);
}
}
@keyframes scroll-left {
0% {
		-webkit-transform: translateX(100%);
		        transform: translateX(100%);
}
100% {
		-webkit-transform: translateX(-100%);
		        transform: translateX(-100%);
}
}
.drug {
	background-color: #f5f5f5;
	padding: 20rpx;
	margin-top: 50rpx;
	width: 85%;
	border: 3px solid #e5e5e5;
	border-radius: 20rpx;
	position: relative;
	height: 350rpx;
}
.drug-title {
	display: flex;
	align-items: center;
	font-weight: bold;
}
.tip {
	width: 60rpx;
	height: 60rpx;
	margin-right: 20rpx;
}
.drug-content {
	display: flex;
	align-items: center;
}
.water {
	width: 120rpx;
	height: 120rpx;
	margin-right: 20rpx;
	margin-top: 40rpx;
}
.drug-text {
	display: flex;
	flex-direction: column;
	margin-left: 20rpx;
}
.time {
	margin-bottom: 8rpx;
	font-size: 40rpx;
}
.eat {
	font-size: 25rpx;
	margin-bottom: 5rpx;
}
.divider {
	width: 100%;
	height: 10rpx;
	background-color: #e5e5e5;
	margin: 15rpx 0;
}
.cup {
	width: 100rpx;
	height: 100rpx;
	margin-right: 40rpx;
}
.date {
	font-size: 35rpx;
	color: dimgrey;
}
.dalay {
	font-size: 60rpx;
	color: limegreen;
	font-weight: bolder;
	position: absolute;
	right: 100rpx;
	/* 将 delay 元素定位到右边 */
}
.share {
	display: flex;
	flex-direction: column;
	margin-top: 40rpx;
}
.title-img {
	width: 60rpx;
	height: 60rpx;
	margin-right: 20rpx;
	margin-left: 30rpx;
}
.more {
	color: dimgray;
	font-size: 30rpx;
	margin-left: auto;
	margin-right: 10rpx;
}
.share-title {
	display: flex;
	font-weight: bold;
	align-items: center;
}
.share-content {
	display: flex;
	justify-content: space-evenly;
	margin-top: 20rpx;
}
.share-item {
	display: flex;
	flex-direction: column;
	background-color: aliceblue;
	border-radius: 20rpx;
	padding: 20rpx;
}
.share-img {
	width: 180rpx;
	height: 180rpx;
}
.share-text {
	font-size: 30rpx;
	margin-top: 20rpx;
	font-weight: bold;
}
.share-price {
	font-size: 30rpx;
	color: red;
	margin-top: 20rpx;
	display: flex;
}
.car {
	width: 60rpx;
	height: 60rpx;
	margin-left: auto;
}
.share-two {
	margin-top: 40rpx;
}
.share-info {
	display: flex;
	background-color: aliceblue;
	border-radius: 20rpx;
	padding: 20rpx;
	margin: 20rpx;
}
.details {
	display: flex;
	flex-direction: column;
	margin-left: 20rpx;
	width: 300rpx;
}
.share-info-text {
	font-size: 30rpx;
	font-weight: bold;
	color: #FDBD2F;
}
.detail {
	font-size: 25rpx;
	margin-top: 20rpx;
	color: dimgrey;
}
.know {
	font-size: 20rpx;
	background-color: #FDBD2F;
	color: white;
	padding: 15rpx;
	margin-left: auto;
	border-radius: 30rpx;
	height: 20rpx;
	margin-top: 10%;
}

