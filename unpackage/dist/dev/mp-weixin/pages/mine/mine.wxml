<view class="page"><custom-nav class="vue-ref" vue-id="bae1c640-1" title="{{pageTitle}}" isHomePage="{{true}}" scrollTop="{{scrollTop}}" data-ref="customNav" bind:__l="__l"></custom-nav><scroll-view class="page-container" style="{{'padding-top:'+(navHeight+'px')+';'+('height:'+('calc(100vh - '+navHeight+'px)')+';')}}" scroll-y="{{true}}" scroll-top="{{scrollTop}}" show-scrollbar="{{false}}" data-event-opts="{{[['scroll',[['handleScroll',['$event']]]]]}}" bindscroll="__e"><view class="content"><view data-event-opts="{{[['tap',[['handleHeaderClick',['$event']]]]]}}" class="header" bindtap="__e"><block wx:if="{{userInfo.type=='陪诊师'}}"><image class="headerimg" src="{{userInfo.moreInfo.avatarUrl||'../../static/images/mine/avatar.png'}}" alt></image></block><block wx:else><image class="headerimg" src="{{userInfo.avatar||'../../static/images/mine/avatar.png'}}" alt></image></block><text class="username">{{userInfo.nickName||"登录"}}</text><block wx:if="{{userInfo.type=='陪诊师'}}"><text class="user-info">{{''+(userInfo.moreInfo.is_certified?"已认证":"未认证")+''}}</text></block><block wx:if="{{userInfo.type=='陪诊师'}}"><image class="sao" src="../../static/images/mine/sao.png" alt="扫描图标" data-event-opts="{{[['tap',[['showQRCode',['$event']]]]]}}" bindtap="__e"></image></block></view><block wx:if="{{userInfo.type=='陪诊师'}}"><view class="account-box"><view data-event-opts="{{[['tap',[['toApply',['$event']]]]]}}" class="account" bindtap="__e"><view class="account-header"><text class="account-title">我的账户</text></view><view class="account-info"><view class="account-item"><text class="account-value">{{$root.g0}}</text><text class="account-label">可提取金额</text></view><view class="account-item"><text class="account-value">{{$root.g1}}</text><text class="account-label">待结算金额</text></view><view class="account-item"><text class="account-value">{{$root.g2}}</text><text class="account-label">累计已结算金额</text></view></view></view><view class="time-options"><view data-event-opts="{{[['tap',[['selectTime',['today']]]]]}}" class="{{['time-option',(selectedTime==='today')?'selected':'']}}" bindtap="__e">今日</view><view data-event-opts="{{[['tap',[['selectTime',['week']]]]]}}" class="{{['time-option',(selectedTime==='week')?'selected':'']}}" bindtap="__e">本周</view><view data-event-opts="{{[['tap',[['selectTime',['month']]]]]}}" class="{{['time-option',(selectedTime==='month')?'selected':'']}}" bindtap="__e">本月</view><view data-event-opts="{{[['tap',[['selectTime',['year']]]]]}}" class="{{['time-option',(selectedTime==='year')?'selected':'']}}" bindtap="__e">今年</view></view><view class="data-display"><view class="data-item"><text class="data-item-item">{{orderCount}}</text><text>订单量</text></view><view class="data-item"><text class="data-item-item">{{salesAmount}}</text><text>销售额</text></view><view class="data-item"><text class="data-item-item">{{pendingAmount}}</text><text>已提现金额</text></view><view class="data-item"><text class="data-item-item">{{settledAmount}}</text><text>已结算金额</text></view></view></view></block><block wx:else><view class="info-box"><view class="money"><text class="money-num">1</text><view class="money-box"><image src="../../static/images/index/money (2).png" alt></image><text class="money-title">当前余额(元)</text></view></view><view class="benefit"><text class="benefit-num">0</text><view class="benefit-box"><image src="../../static/images/index/card.png" alt></image><text class="benefit-title">优惠券</text></view></view></view></block><view class="order-box"><text class="order-title">订单管理</text><block wx:if="{{userInfo.type=='陪诊师'}}"><view class="order-item"><view data-event-opts="{{[['tap',[['goToOrderManage',['pending']]]]]}}" class="box" style="margin-left:0;" bindtap="__e"><image src="../../static/images/mine/ordering.png"></image><text class="box-title">待接单</text></view><view data-event-opts="{{[['tap',[['goToOrderManage',['processing']]]]]}}" class="box" bindtap="__e"><image src="../../static/images/mine/willdo.png"></image><text class="box-title">服务中</text></view><view data-event-opts="{{[['tap',[['goToOrderManage',['completed']]]]]}}" class="box" bindtap="__e"><image src="../../static/images/mine/finish.png"></image><text class="box-title">已完成</text></view><view data-event-opts="{{[['tap',[['goToOrderManage',['cancelled']]]]]}}" class="box" bindtap="__e"><image src="../../static/images/mine/cancel.png"></image><text class="box-title">已取消</text></view></view></block><block wx:else><view class="order-item"><view data-event-opts="{{[['tap',[['goToOrderManage',['paying']]]]]}}" class="box" style="margin-left:0;" bindtap="__e"><image src="../../static/images/mine/willdo.png"></image><text class="box-title">待付款</text></view><view data-event-opts="{{[['tap',[['goToOrderManage',['pending']]]]]}}" class="box" bindtap="__e"><image src="../../static/images/mine/ordering.png"></image><text class="box-title">待服务</text></view><view data-event-opts="{{[['tap',[['goToOrderManage',['completed']]]]]}}" class="box" bindtap="__e"><image src="../../static/images/mine/finish.png"></image><text class="box-title">已完成</text></view><view data-event-opts="{{[['tap',[['goToOrderManage',['cancelled']]]]]}}" class="box" bindtap="__e"><image src="../../static/images/mine/cancel.png"></image><text class="box-title">已取消</text></view></view></block></view><view class="order-box"><text class="order-title">我的工具</text><block wx:if="{{userInfo.type=='陪诊师'}}"><view class="order-item"><view data-event-opts="{{[['tap',[['doctorRegister',['$event']]]]]}}" class="boxed" bindtap="__e"><image src="../../static/images/mine/patient.png" alt></image><text class="box-title">个人信息管理</text></view><view data-event-opts="{{[['tap',[['goToSetTime',['$event']]]]]}}" class="boxed" bindtap="__e"><image src="../../static/images/mine/advice.png" alt></image><text class="box-title">查看用户评价</text></view><view data-event-opts="{{[['tap',[['goToChat',['$event']]]]]}}" class="box" bindtap="__e"><image src="../../static/images/mine/chat1.png" alt></image><text class="box-title">聊天</text></view><view data-event-opts="{{[['tap',[['goSetting',['$event']]]]]}}" class="boxed" bindtap="__e"><image src="../../static/images/mine/setting.png" alt></image><text class="box-title">设置中心</text></view></view></block><block wx:else><view class="order-item"><view class="box" style="margin-left:0;" id="box1"><image src="../../static/images/mine/location.png" alt></image><text class="box-title">地址管理</text></view><view data-event-opts="{{[['tap',[['goPationManager',['$event']]]]]}}" class="box" bindtap="__e"><image src="../../static/images/mine/patient.png" alt></image><text class="box-title">就诊人管理</text></view><view data-event-opts="{{[['tap',[['goToChat',['$event']]]]]}}" class="box" bindtap="__e"><image src="../../static/images/mine/chat1.png" alt></image><text class="box-title">聊天</text></view><view class="box"><image src="../../static/images/mine/advice.png" alt></image><text class="box-title">投诉建议</text></view><view data-event-opts="{{[['tap',[['doctorRegister',['$event']]]]]}}" class="box" style="margin-left:0;" bindtap="__e"><image src="../../static/images/mine/help.png" alt></image><text class="box-title">陪诊师入驻</text></view><view data-event-opts="{{[['tap',[['goSetting',['$event']]]]]}}" class="box" bindtap="__e"><image src="../../static/images/mine/setting.png" alt></image><text class="box-title">设置中心</text></view></view></block></view><view class="logout-box"><image src="../../static/images/mine/logout.png" alt></image><block wx:if="{{userInfo.user_id}}"><button data-event-opts="{{[['tap',[['logout',['$event']]]]]}}" class="logout" bindtap="__e">退出登录</button></block></view></view></scroll-view></view>