.error-field.data-v-127632e4 {
	border: 1px solid #ff4d4f !important;
	border-radius: 8rpx;
	-webkit-animation: shake-data-v-127632e4 0.5s;
	        animation: shake-data-v-127632e4 0.5s;
}
@-webkit-keyframes shake-data-v-127632e4 {
0%,
	100% {
		-webkit-transform: translateX(0);
		        transform: translateX(0);
}
25% {
		-webkit-transform: translateX(-5px);
		        transform: translateX(-5px);
}
75% {
		-webkit-transform: translateX(5px);
		        transform: translateX(5px);
}
}
@keyframes shake-data-v-127632e4 {
0%,
	100% {
		-webkit-transform: translateX(0);
		        transform: translateX(0);
}
25% {
		-webkit-transform: translateX(-5px);
		        transform: translateX(-5px);
}
75% {
		-webkit-transform: translateX(5px);
		        transform: translateX(5px);
}
}
